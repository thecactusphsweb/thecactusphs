// Rename API routes/domain values before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thecactusphs",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-03-29",
  "vars": {
    "GITHUB_OWNER": "thecactusphsweb",
    "GITHUB_REPO": "thecactusphs",
    "GITHUB_BRANCH": "main",
    "ALLOWED_ORIGINS": "https://thecactusphs.com,https://www.thecactusphs.com",
    "ADMIN_COOKIE_NAME": "cactus_admin_session",
    "COOKIE_SECURE": "true"
  }
}
